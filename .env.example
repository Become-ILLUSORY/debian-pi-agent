# ============================================================
# debian-pi-agent 配置：复制成 .env 后按需修改
# ============================================================

# ===== 1. 模型（中转站优先，二选一）=====
# 中转站/兼容端点：填了 BASE_URL 会自动拉 /models 写进 Pi 的 models.json
PI_RELAY_NAME=relay
PI_RELAY_BASE_URL=
PI_RELAY_API_KEY=
# openai-completions（中转站绝大多数用这个）| openai-responses | anthropic-messages
PI_RELAY_API=
# 自动拉取 /models；设为 0 则只用下面的手写清单
PI_RELAY_SYNC=1
# 手写模型清单（自动拉取失败时兜底）：gpt-5.1,claude-sonnet-4-5
PI_RELAY_MODELS=
# 只保留匹配的模型（逗号分隔，支持 * 通配）：gpt-*,claude-*
PI_RELAY_MODEL_FILTER=
# 默认排除非对话模型（embedding/tts/rerank 等）；设为空字符串则不排除
PI_RELAY_EXCLUDE=embed,embedding,whisper,tts,rerank,moderation,dall-e,gpt-image,stable-diffusion,sdxl,flux,veo,sora,kling,seedream,seedance
# 默认模型（写进 settings.json，飞书/终端新会话直接用这个）
PI_RELAY_DEFAULT_MODEL=
PI_RELAY_CONTEXT_WINDOW=128000
PI_RELAY_MAX_TOKENS=16384
# 模型支持图片输入时设 1
PI_RELAY_VISION=0
# 计价（USD / 百万 token，只影响用量估算显示）
PI_RELAY_COST_INPUT=0
PI_RELAY_COST_OUTPUT=0

# 官方直连（不填中转站时生效，Pi 自己读取）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# ===== 2. 飞书机器人 =====
# 1 = 启用（默认，异地控制通道）；auto = 有 appId/appSecret 才启动；0 = 关闭
FEISHU_ENABLED=1
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BOT_NAME=Pi Agent
# shared-chat（整群共享会话）| per-user（群内按人隔离）
FEISHU_GROUP_SCOPE=shared-chat
FEISHU_REQUIRE_MENTION=1
FEISHU_DM_ENABLED=1
FEISHU_GROUP_ENABLED=1
# 白名单，逗号分隔（open_id / chat_id）；留空不限制
FEISHU_ALLOW_USERS=
FEISHU_ALLOW_CHATS=
# stream-card | markdown | text
FEISHU_RENDERING_MODE=stream-card
# fatal|error|warn|info|debug|trace
FEISHU_LOG_LEVEL=info
FEISHU_DEBUG_EVENTS=0
FEISHU_MAX_UPLOAD_MB=20
# 允许 send_file_to_chat 回传的目录（逗号分隔），留空=工作目录
FEISHU_ALLOWED_OUTPUT_DIRS=
# 会话空闲回收（分钟），留空=30
FEISHU_IDLE_TTL_MIN=
# 是否显示工具调用事件 / 思考内容（quote|plain|hide）
FEISHU_SHOW_TOOL_EVENTS=1
FEISHU_SHOW_THINKING=quote
# 连续异常退出的最大重启次数；0 = 不限（退避封顶 5 分钟）
FEISHU_RESTART_LIMIT=0
# 自定义配置路径（容器内），留空则用上面的环境变量生成 ~/.pi/agent/feishu.json
FEISHU_CONFIG=
FEISHU_CONFIG_FORCE=0
# 启动前额外自检凭证（只打日志，不阻止启动）
FEISHU_PREFLIGHT=0

# ===== 3. SSH / 运行 =====
SSH_PASSWORD=pi
# 备用普通用户 dev 的密码（留空则不设；容器默认仍以 root 运行）
DEV_PASSWORD=
# 留空则沿用镜像默认 yes
SSH_PERMIT_ROOT_LOGIN=yes
SSH_PASSWORD_AUTH=yes
SSH_PORT=2222
# agent 工作目录（容器内路径，凭据在 ~/.pi 不在这里）
PI_WORKDIR=/workspace
# 容器内只用 root；挂载到宿主的数据目录
DATA_DIR=./data
TZ=Asia/Shanghai

# ===== 4. 镜像 =====
# 基础镜像默认钉死 digest（可复现）；想跟随 debian:trixie-slim 的最新就把 @sha256:... 去掉
DEBIAN_VERSION=trixie-slim@sha256:a29215f6a35e51e22adffa17f89e9d2ef06214e64a2bad10d765c46aea49f11f
NODE_VERSION=22.23.3
IMAGE_NAME=debian-pi-agent
# 建议随内容升级（如 1.0.0 / 1.1.0），方便回滚到上一个镜像
IMAGE_TAG=latest
CONTAINER_NAME=pi-agent

# ---- 组件版本（写 latest = 每次构建拿最新；写死版本号 = 可复现）----
PI_VERSION=latest
PI_REMOTE_FEISHU_VERSION=latest
# 1 = 用仓库里的 npm/package-lock.json 严格锁定（依赖树逐层固定，升级需 ./update-deps.sh）
# 0 = 按上面两行的版本装（默认，升级只改上面两行）
PI_STRICT_LOCK=0
PI_FEISHU_EXTENSION=0
